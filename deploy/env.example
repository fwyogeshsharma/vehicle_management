# Reference for /etc/vehicle-management/env (setup.sh creates the real one, mode 600).
VM_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/vehicle_management
VM_DATABASE_USER=vmgmt
VM_DATABASE_PASSWORD=change-me
# openssl rand -base64 48   -- boot fails without it, by design
VM_JWT_SECRET=change-me
# First administrator; skipped with a warning unless all three are set.
VM_ADMIN_USERNAME=
VM_ADMIN_PASSWORD=
VM_ADMIN_MOBILE=
# Exact origin(s) of the UI, comma-separated. Never a wildcard.
VM_CORS_ORIGINS=https://ui.example.com
VM_IMAGE_BACKEND=local
VM_IMAGE_DIR=/var/lib/vehicle-management/uploads
# Leave false in production.
VM_SEED_SAMPLE=false
