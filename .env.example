# start-prod.sh creates .env from this shape, generating the secrets.
DB_PASSWORD=
VM_JWT_SECRET=
VM_ADMIN_USERNAME=
VM_ADMIN_PASSWORD=
VM_ADMIN_MOBILE=
# Exact UI origin(s), comma-separated. Never a wildcard.
VM_CORS_ORIGINS=https://trucks.rollingradius.com
# Set to a domain pointing at this VM to get automatic HTTPS (Caddy). Blank = plain HTTP on APP_PORT.
DOMAIN=api.trucks.rollingradius.com
# With DOMAIN set, use APP_BIND=127.0.0.1 so only Caddy is public.
APP_BIND=127.0.0.1
APP_PORT=8080
# PostgreSQL published on the VM. 127.0.0.1 = local only; 0.0.0.0 = reachable from outside
# (then restrict the GCP firewall rule for 5432 to your own IPs).
DB_BIND=127.0.0.1
DB_PORT=5432
# Photo storage: local (Docker volume) or gcs. With gcs, the OCR worker must read the same bucket.
VM_IMAGE_BACKEND=local
VM_GCS_BUCKET=
VM_GCS_PREFIX=

# Optional pgAdmin (docker-compose --profile pgadmin up -d pgadmin)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
  PGADMIN_EMAIL=admin@admin.com
  PGADMIN_PASSWORD=<a password of 6+ characters>
  PGADMIN_BIND=0.0.0.0
  PGADMIN_PORT=5050